# Local development only. Never reuse these values in production.
NODE_ENV=development

# PostgreSQL (the password below is mandated for local development only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=200520
POSTGRES_DB=aegisflow_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:200520@postgres:5432/aegisflow_db
DATABASE_URL_LOCAL=postgresql://postgres:200520@localhost:5432/aegisflow_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379

# MinIO (development-only example credentials)
MINIO_ROOT_USER=aegisflow_local
MINIO_ROOT_PASSWORD=change-this-local-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_LOCAL=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=aegisflow_local
MINIO_SECRET_KEY=change-this-local-minio-password
MINIO_BUCKET_EVIDENCE=aegisflow-evidence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Applications
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
PROXY_PORT=8080
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://api:3001/api/v1
EVENT_SIMULATOR_API_URL=http://localhost:3001/api/v1
EVENT_SIMULATOR_API_KEY=
EVENT_SIMULATOR_CONNECTOR_ID=
EVENT_SIMULATOR_COUNT=10
EVENT_SIMULATOR_ORGANIZATION_ID=

# Identity (development-only examples; replace all three independently in production)
AUTH_JWT_SECRET=dev-only-jwt-secret-change-before-production-2026
AUTH_TOKEN_PEPPER=dev-only-token-pepper-change-before-production-2026
AUTH_ENCRYPTION_KEY=ZGV2LW9ubHktYWVzLWtleS0zMi1ieXRlcy1sb25nISE=
AUTH_ISSUER=aegisflow-api
AUTH_AUDIENCE=aegisflow-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=aegisflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-grafana-password
