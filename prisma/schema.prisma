generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum MfaMethodType {
  TOTP

  @@map("mfa_method_type")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum AssetType {
  APPLICATION
  SERVER
  API
  DATABASE
  REPOSITORY
  OTHER

  @@map("asset_type")
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("asset_criticality")
}

enum AssetStatus {
  ACTIVE
  ARCHIVED

  @@map("asset_status")
}

enum AssetDependencyKind {
  DEPENDS_ON
  HOSTED_ON
  CONNECTS_TO
  STORES_DATA_IN
  USES

  @@map("asset_dependency_kind")
}

enum ConnectorType {
  WEBHOOK
  REST_API
  JSON_IMPORT
  CSV_IMPORT
  GITHUB
  SIMULATOR

  @@map("connector_type")
}

enum ConnectorStatus {
  ACTIVE
  DISABLED

  @@map("connector_status")
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED

  @@map("idempotency_status")
}

enum RawEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  NORMALIZED
  REJECTED
  FAILED

  @@map("raw_event_status")
}

enum EventFormat {
  JSON
  CSV

  @@map("event_format")
}

enum EventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("event_severity")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  SUPPRESSED
  CLOSED

  @@map("alert_status")
}

enum CorrelationDimension {
  ACTOR_USER
  SOURCE_IP
  ASSET
  EVENT_TYPE
  FINGERPRINT

  @@map("correlation_dimension")
}

model Organization {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                 @db.VarChar(120)
  slug               String                 @unique @db.VarChar(80)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  mfaChallenges      MfaChallenge[]
  assets             Asset[]
  assetDependencies  AssetDependency[]
  connectors         Connector[]
  webhookSecrets     WebhookSecret[]
  apiKeys            ApiKey[]
  idempotencyRecords IdempotencyRecord[]
  rawEvents          RawEvent[]
  normalizedEvents   NormalizedEvent[]
  detectionRules     DetectionRule[]
  detectionVersions  DetectionRuleVersion[]
  ruleExecutions     RuleExecution[]
  anomalyScores      AnomalyScore[]
  alerts             Alert[]
  alertEvents        AlertEvent[]
  correlationEdges   AlertCorrelationEdge[]
  eventRecords       EventRecord[]
  outboxEvents       OutboxEvent[]

  @@map("organizations")
}

model User {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String              @db.VarChar(254)
  normalizedEmail       String              @unique @map("normalized_email") @db.VarChar(254)
  displayName           String              @map("display_name") @db.VarChar(120)
  status                UserStatus          @default(ACTIVE)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  credential            Credential?
  mfaMethods            MfaMethod[]
  recoveryCodes         RecoveryCode[]
  memberships           Membership[]
  sessions              Session[]
  mfaChallenges         MfaChallenge[]
  invitationsSent       Invitation[]        @relation("InvitationSender")
  invitationsTaken      Invitation[]        @relation("InvitationAcceptor")
  webhookSecretsCreated WebhookSecret[]     @relation("WebhookSecretCreator")
  apiKeysCreated        ApiKey[]            @relation("ApiKeyCreator")
  idempotencyRecords    IdempotencyRecord[]
  eventRecords          EventRecord[]       @relation("EventRecordActor")
  detectionRulesCreated DetectionRule[]     @relation("DetectionRuleCreator")
  detectionRulesUpdated DetectionRule[]     @relation("DetectionRuleUpdater")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Credential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.Text
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credentials")
}

model MfaMethod {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  type              MfaMethodType @default(TOTP)
  label             String        @db.VarChar(80)
  encryptedSecret   String        @map("encrypted_secret") @db.Text
  encryptionIv      String        @map("encryption_iv") @db.VarChar(32)
  encryptionAuthTag String        @map("encryption_auth_tag") @db.VarChar(32)
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz(6)
  lastUsedCounter   BigInt?       @map("last_used_counter")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type], map: "mfa_methods_user_type_key")
  @@index([userId, verifiedAt], map: "mfa_methods_user_verified_idx")
  @@map("mfa_methods")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, codeHash], map: "recovery_codes_user_hash_key")
  @@index([userId, usedAt], map: "recovery_codes_user_unused_idx")
  @@map("recovery_codes")
}

model Membership {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  membershipRoles MembershipRole[]
  ownedAssets     Asset[]
  assignedAlerts  Alert[]

  @@unique([organizationId, userId], map: "memberships_org_user_key")
  @@unique([id, organizationId], map: "memberships_id_org_key")
  @@index([userId, status], map: "memberships_user_status_idx")
  @@index([organizationId, status], map: "memberships_org_status_idx")
  @@map("memberships")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  key             String           @db.VarChar(64)
  name            String           @db.VarChar(80)
  description     String           @db.VarChar(240)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  invitations     Invitation[]

  @@unique([organizationId, key], map: "roles_org_key_key")
  @@unique([id, organizationId], map: "roles_id_org_key")
  @@index([organizationId, isSystem], map: "roles_org_system_idx")
  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String           @unique @db.VarChar(100)
  description     String           @db.VarChar(240)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionId   String     @map("permission_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([organizationId, roleId, permissionId])
  @@index([organizationId, permissionId], map: "role_permissions_org_permission_idx")
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String     @map("organization_id") @db.Uuid
  membershipId   String     @map("membership_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([organizationId, membershipId, roleId])
  @@index([organizationId, roleId], map: "membership_roles_org_role_idx")
  @@map("membership_roles")
}

model Invitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(254)
  normalizedEmail  String           @map("normalized_email") @db.VarChar(254)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  roleId           String           @map("role_id") @db.Uuid
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role             Role             @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt], map: "invitations_org_status_expiry_idx")
  @@index([normalizedEmail, status], map: "invitations_email_status_idx")
  @@map("invitations")
}

model Session {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  deviceName     String         @map("device_name") @db.VarChar(120)
  userAgentHash  String         @map("user_agent_hash") @db.Char(64)
  ipAddress      String         @map("ip_address") @db.Inet
  mfaVerifiedAt  DateTime?      @map("mfa_verified_at") @db.Timestamptz(6)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason   String?        @map("revoke_reason") @db.VarChar(80)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]

  @@unique([id, organizationId], map: "sessions_id_org_key")
  @@index([organizationId, userId, revokedAt], map: "sessions_org_user_active_idx")
  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model RefreshToken {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  familyId       String        @map("family_id") @db.Uuid
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  parentTokenId  String?       @unique @map("parent_token_id") @db.Uuid
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session        Session       @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentToken    RefreshToken? @relation("RefreshTokenChain", fields: [parentTokenId], references: [id], onDelete: Restrict)
  childToken     RefreshToken? @relation("RefreshTokenChain")

  @@index([organizationId, sessionId, expiresAt], map: "refresh_tokens_org_session_expiry_idx")
  @@index([familyId, revokedAt], map: "refresh_tokens_family_revoked_idx")
  @@map("refresh_tokens")
}

model MfaChallenge {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  attempts       Int          @default(0)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, expiresAt], map: "mfa_challenges_org_user_expiry_idx")
  @@map("mfa_challenges")
}

model Asset {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  ownerMembershipId  String?           @map("owner_membership_id") @db.Uuid
  key                String            @db.VarChar(64)
  name               String            @db.VarChar(120)
  description        String            @default("") @db.VarChar(500)
  type               AssetType
  criticality        AssetCriticality
  status             AssetStatus       @default(ACTIVE)
  tags               String[]          @default([])
  version            Int               @default(1)
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner              Membership?       @relation(fields: [ownerMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceDependencies AssetDependency[] @relation("AssetDependencySource")
  targetDependencies AssetDependency[] @relation("AssetDependencyTarget")
  normalizedEvents   NormalizedEvent[]
  alerts             Alert[]

  @@unique([organizationId, key], map: "assets_org_key_key")
  @@unique([id, organizationId], map: "assets_id_org_key")
  @@index([organizationId, status, criticality], map: "assets_org_status_criticality_idx")
  @@index([organizationId, ownerMembershipId], map: "assets_org_owner_idx")
  @@map("assets")
}

model AssetDependency {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  sourceAssetId  String              @map("source_asset_id") @db.Uuid
  targetAssetId  String              @map("target_asset_id") @db.Uuid
  kind           AssetDependencyKind
  description    String              @default("") @db.VarChar(240)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceAsset    Asset               @relation("AssetDependencySource", fields: [sourceAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  targetAsset    Asset               @relation("AssetDependencyTarget", fields: [targetAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceAssetId, targetAssetId, kind], map: "asset_dependencies_edge_key")
  @@unique([id, organizationId], map: "asset_dependencies_id_org_key")
  @@index([organizationId, targetAssetId], map: "asset_dependencies_org_target_idx")
  @@map("asset_dependencies")
}

model Connector {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  key              String            @db.VarChar(64)
  name             String            @db.VarChar(120)
  description      String            @default("") @db.VarChar(500)
  type             ConnectorType
  status           ConnectorStatus   @default(ACTIVE)
  configuration    Json              @default("{}")
  version          Int               @default(1)
  lastSeenAt       DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  webhookSecrets   WebhookSecret[]
  apiKeys          ApiKey[]
  rawEvents        RawEvent[]
  normalizedEvents NormalizedEvent[]

  @@unique([organizationId, key], map: "connectors_org_key_key")
  @@unique([id, organizationId], map: "connectors_id_org_key")
  @@index([organizationId, status, type], map: "connectors_org_status_type_idx")
  @@map("connectors")
}

model RawEvent {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  connectorId       String            @map("connector_id") @db.Uuid
  format            EventFormat
  status            RawEventStatus    @default(RECEIVED)
  contentType       String            @map("content_type") @db.VarChar(120)
  sourceEventId     String?           @map("source_event_id") @db.VarChar(128)
  deduplicationKey  String            @map("deduplication_key") @db.Char(64)
  payloadHash       String            @map("payload_hash") @db.Char(64)
  encryptedPayload  String            @map("encrypted_payload") @db.Text
  encryptionIv      String            @map("encryption_iv") @db.VarChar(32)
  encryptionAuthTag String            @map("encryption_auth_tag") @db.VarChar(32)
  payloadSize       Int               @map("payload_size")
  recordCount       Int               @map("record_count")
  correlationId     String            @map("correlation_id") @db.VarChar(128)
  retryCount        Int               @default(0) @map("retry_count")
  rejectionCode     String?           @map("rejection_code") @db.VarChar(80)
  receivedAt        DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  queuedAt          DateTime?         @map("queued_at") @db.Timestamptz(6)
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz(6)
  retentionUntil    DateTime          @map("retention_until") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector         Connector         @relation(fields: [connectorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  normalizedEvents  NormalizedEvent[]

  @@unique([organizationId, connectorId, deduplicationKey], map: "raw_events_org_connector_dedup_key")
  @@unique([id, organizationId], map: "raw_events_id_org_key")
  @@index([organizationId, status, receivedAt], map: "raw_events_org_status_received_idx")
  @@index([status, receivedAt], map: "raw_events_dispatch_idx")
  @@index([retentionUntil], map: "raw_events_retention_idx")
  @@map("raw_events")
}

model NormalizedEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  rawEventId     String          @map("raw_event_id") @db.Uuid
  connectorId    String          @map("connector_id") @db.Uuid
  assetId        String?         @map("asset_id") @db.Uuid
  recordIndex    Int             @map("record_index")
  sourceEventId  String?         @map("source_event_id") @db.VarChar(128)
  eventType      String          @map("event_type") @db.VarChar(120)
  severity       EventSeverity
  message        String          @default("") @db.VarChar(2000)
  actorUserHash  String?         @map("actor_user_hash") @db.Char(64)
  sourceIpHash   String?         @map("source_ip_hash") @db.Char(64)
  attributes     Json            @default("{}")
  fingerprint    String          @db.Char(64)
  schemaVersion  String          @default("1.0") @map("schema_version") @db.VarChar(20)
  maskingVersion String          @default("1.0") @map("masking_version") @db.VarChar(20)
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime        @map("received_at") @db.Timestamptz(6)
  normalizedAt   DateTime        @default(now()) @map("normalized_at") @db.Timestamptz(6)
  retentionUntil DateTime        @map("retention_until") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rawEvent       RawEvent        @relation(fields: [rawEventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connector      Connector       @relation(fields: [connectorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  asset          Asset?          @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ruleExecutions RuleExecution[]
  anomalyScores  AnomalyScore[]
  alertEvents    AlertEvent[]

  @@unique([rawEventId, recordIndex], map: "normalized_events_raw_record_key")
  @@unique([id, organizationId], map: "normalized_events_id_org_key")
  @@index([organizationId, occurredAt, id], map: "normalized_events_org_cursor_idx")
  @@index([organizationId, severity, occurredAt], map: "normalized_events_org_severity_idx")
  @@index([organizationId, eventType, occurredAt], map: "normalized_events_org_type_idx")
  @@index([organizationId, assetId, occurredAt], map: "normalized_events_org_asset_idx")
  @@index([retentionUntil], map: "normalized_events_retention_idx")
  @@map("normalized_events")
}

model DetectionRule {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                 @map("organization_id") @db.Uuid
  key                        String                 @db.VarChar(80)
  name                       String                 @db.VarChar(120)
  description                String                 @default("") @db.VarChar(1000)
  enabled                    Boolean                @default(false)
  severity                   EventSeverity
  threshold                  Int                    @default(1)
  windowSeconds              Int                    @map("window_seconds")
  deduplicationWindowSeconds Int                    @map("deduplication_window_seconds")
  condition                  Json
  correlationDimensions      CorrelationDimension[] @map("correlation_dimensions")
  version                    Int                    @default(1)
  createdByUserId            String                 @map("created_by_user_id") @db.Uuid
  updatedByUserId            String                 @map("updated_by_user_id") @db.Uuid
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                  User                   @relation("DetectionRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                  User                   @relation("DetectionRuleUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  versions                   DetectionRuleVersion[]
  executions                 RuleExecution[]
  alerts                     Alert[]

  @@unique([organizationId, key], map: "detection_rules_org_key_key")
  @@unique([id, organizationId], map: "detection_rules_id_org_key")
  @@index([organizationId, enabled, updatedAt], map: "detection_rules_org_enabled_idx")
  @@map("detection_rules")
}

model DetectionRuleVersion {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                 @map("organization_id") @db.Uuid
  ruleId                     String                 @map("rule_id") @db.Uuid
  version                    Int
  name                       String                 @db.VarChar(120)
  description                String                 @db.VarChar(1000)
  severity                   EventSeverity
  threshold                  Int
