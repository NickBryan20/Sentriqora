  deduplicationWindowSeconds Int                    @map("deduplication_window_seconds")
  condition                  Json
  correlationDimensions      CorrelationDimension[] @map("correlation_dimensions")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rule                       DetectionRule          @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  executions                 RuleExecution[]

  @@unique([organizationId, ruleId, version], map: "detection_rule_versions_org_rule_version_key")
  @@unique([id, organizationId], map: "detection_rule_versions_id_org_key")
  @@map("detection_rule_versions")
}

model RuleExecution {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  ruleId            String               @map("rule_id") @db.Uuid
  ruleVersionId     String               @map("rule_version_id") @db.Uuid
  normalizedEventId String               @map("normalized_event_id") @db.Uuid
  matched           Boolean
  observedCount     Int                  @map("observed_count")
  riskScore         Decimal              @map("risk_score") @db.Decimal(6, 3)
  durationMs        Int                  @map("duration_ms")
  executedAt        DateTime             @default(now()) @map("executed_at") @db.Timestamptz(6)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rule              DetectionRule        @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ruleVersion       DetectionRuleVersion @relation(fields: [ruleVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  normalizedEvent   NormalizedEvent      @relation(fields: [normalizedEventId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, ruleVersionId, normalizedEventId], map: "rule_executions_org_version_event_key")
  @@index([organizationId, ruleId, executedAt], map: "rule_executions_org_rule_time_idx")
  @@map("rule_executions")
}

model AnomalyScore {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  normalizedEventId String          @map("normalized_event_id") @db.Uuid
  algorithm         String          @default("zscore-hourly-v1") @db.VarChar(40)
  baselineMean      Decimal         @map("baseline_mean") @db.Decimal(14, 6)
  baselineStdDev    Decimal         @map("baseline_stddev") @db.Decimal(14, 6)
  movingAverage     Decimal         @map("moving_average") @db.Decimal(14, 6)
  observedValue     Decimal         @map("observed_value") @db.Decimal(14, 6)
  score             Decimal         @db.Decimal(8, 4)
  isAnomalous       Boolean         @map("is_anomalous")
  calculatedAt      DateTime        @default(now()) @map("calculated_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  normalizedEvent   NormalizedEvent @relation(fields: [normalizedEventId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, normalizedEventId, algorithm], map: "anomaly_scores_org_event_algorithm_key")
  @@index([organizationId, isAnomalous, calculatedAt], map: "anomaly_scores_org_anomalous_idx")
  @@map("anomaly_scores")
}

model Alert {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  ruleId               String                 @map("rule_id") @db.Uuid
  assetId              String?                @map("asset_id") @db.Uuid
  assignedMembershipId String?                @map("assigned_membership_id") @db.Uuid
  deduplicationKey     String                 @map("deduplication_key") @db.Char(64)
  correlationKey       String                 @map("correlation_key") @db.VarChar(512)
  title                String                 @db.VarChar(200)
  description          String                 @default("") @db.VarChar(2000)
  severity             EventSeverity
  status               AlertStatus            @default(OPEN)
  riskScore            Decimal                @map("risk_score") @db.Decimal(6, 3)
  occurrenceCount      Int                    @default(1) @map("occurrence_count")
  firstSeenAt          DateTime               @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt           DateTime               @map("last_seen_at") @db.Timestamptz(6)
  acknowledgedAt       DateTime?              @map("acknowledged_at") @db.Timestamptz(6)
  suppressedUntil      DateTime?              @map("suppressed_until") @db.Timestamptz(6)
  suppressionReason    String?                @map("suppression_reason") @db.VarChar(500)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rule                 DetectionRule          @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  asset                Asset?                 @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedMembership   Membership?            @relation(fields: [assignedMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events               AlertEvent[]
  outgoingCorrelations AlertCorrelationEdge[] @relation("CorrelationSource")
  incomingCorrelations AlertCorrelationEdge[] @relation("CorrelationTarget")

  @@unique([organizationId, deduplicationKey], map: "alerts_org_dedup_key")
  @@unique([id, organizationId], map: "alerts_id_org_key")
  @@index([organizationId, status, severity, lastSeenAt, id], map: "alerts_org_cursor_idx")
  @@index([organizationId, assignedMembershipId, status], map: "alerts_org_assignee_idx")
  @@map("alerts")
}

model AlertEvent {
  organizationId    String          @map("organization_id") @db.Uuid
  alertId           String          @map("alert_id") @db.Uuid
  normalizedEventId String          @map("normalized_event_id") @db.Uuid
  linkedAt          DateTime        @default(now()) @map("linked_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alert             Alert           @relation(fields: [alertId, organizationId], references: [id, organizationId], onDelete: Restrict)
  normalizedEvent   NormalizedEvent @relation(fields: [normalizedEventId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([organizationId, alertId, normalizedEventId])
  @@index([organizationId, normalizedEventId], map: "alert_events_org_event_idx")
  @@map("alert_events")
}

model AlertCorrelationEdge {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  sourceAlertId  String               @map("source_alert_id") @db.Uuid
  targetAlertId  String               @map("target_alert_id") @db.Uuid
  dimension      CorrelationDimension
  valueHash      String               @map("value_hash") @db.Char(64)
  weight         Int                  @default(1)
  firstSeenAt    DateTime             @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceAlert    Alert                @relation("CorrelationSource", fields: [sourceAlertId, organizationId], references: [id, organizationId], onDelete: Restrict)
  targetAlert    Alert                @relation("CorrelationTarget", fields: [targetAlertId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceAlertId, targetAlertId, dimension, valueHash], map: "alert_correlations_edge_key")
  @@index([organizationId, sourceAlertId, lastSeenAt], map: "alert_correlations_source_idx")
  @@index([organizationId, targetAlertId, lastSeenAt], map: "alert_correlations_target_idx")
  @@map("alert_correlation_edges")
}

