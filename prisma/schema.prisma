generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum MfaMethodType {
  TOTP

  @@map("mfa_method_type")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum AssetType {
  APPLICATION
  SERVER
  API
  DATABASE
  REPOSITORY
  OTHER

  @@map("asset_type")
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("asset_criticality")
}

enum AssetStatus {
  ACTIVE
  ARCHIVED

  @@map("asset_status")
}

enum AssetDependencyKind {
  DEPENDS_ON
  HOSTED_ON
  CONNECTS_TO
  STORES_DATA_IN
  USES

  @@map("asset_dependency_kind")
}

enum ConnectorType {
  WEBHOOK
  REST_API
  JSON_IMPORT
  CSV_IMPORT
  GITHUB
  SIMULATOR

  @@map("connector_type")
}

enum ConnectorStatus {
  ACTIVE
  DISABLED

  @@map("connector_status")
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED

  @@map("idempotency_status")
}

model Organization {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String              @db.VarChar(120)
  slug               String              @unique @db.VarChar(80)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  mfaChallenges      MfaChallenge[]
  assets             Asset[]
  assetDependencies  AssetDependency[]
  connectors         Connector[]
  webhookSecrets     WebhookSecret[]
  apiKeys            ApiKey[]
  idempotencyRecords IdempotencyRecord[]
  eventRecords       EventRecord[]
  outboxEvents       OutboxEvent[]

  @@map("organizations")
}

model User {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String              @db.VarChar(254)
  normalizedEmail       String              @unique @map("normalized_email") @db.VarChar(254)
  displayName           String              @map("display_name") @db.VarChar(120)
  status                UserStatus          @default(ACTIVE)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  credential            Credential?
  mfaMethods            MfaMethod[]
  recoveryCodes         RecoveryCode[]
  memberships           Membership[]
  sessions              Session[]
  mfaChallenges         MfaChallenge[]
  invitationsSent       Invitation[]        @relation("InvitationSender")
  invitationsTaken      Invitation[]        @relation("InvitationAcceptor")
  webhookSecretsCreated WebhookSecret[]     @relation("WebhookSecretCreator")
  apiKeysCreated        ApiKey[]            @relation("ApiKeyCreator")
  idempotencyRecords    IdempotencyRecord[]
  eventRecords          EventRecord[]       @relation("EventRecordActor")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Credential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.Text
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credentials")
}

model MfaMethod {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  type              MfaMethodType @default(TOTP)
  label             String        @db.VarChar(80)
  encryptedSecret   String        @map("encrypted_secret") @db.Text
  encryptionIv      String        @map("encryption_iv") @db.VarChar(32)
  encryptionAuthTag String        @map("encryption_auth_tag") @db.VarChar(32)
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz(6)
  lastUsedCounter   BigInt?       @map("last_used_counter")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type], map: "mfa_methods_user_type_key")
  @@index([userId, verifiedAt], map: "mfa_methods_user_verified_idx")
  @@map("mfa_methods")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, codeHash], map: "recovery_codes_user_hash_key")
  @@index([userId, usedAt], map: "recovery_codes_user_unused_idx")
  @@map("recovery_codes")
}

model Membership {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  membershipRoles MembershipRole[]
  ownedAssets     Asset[]

  @@unique([organizationId, userId], map: "memberships_org_user_key")
  @@unique([id, organizationId], map: "memberships_id_org_key")
  @@index([userId, status], map: "memberships_user_status_idx")
  @@index([organizationId, status], map: "memberships_org_status_idx")
  @@map("memberships")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  key             String           @db.VarChar(64)
  name            String           @db.VarChar(80)
  description     String           @db.VarChar(240)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  invitations     Invitation[]

  @@unique([organizationId, key], map: "roles_org_key_key")
  @@unique([id, organizationId], map: "roles_id_org_key")
  @@index([organizationId, isSystem], map: "roles_org_system_idx")
  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String           @unique @db.VarChar(100)
  description     String           @db.VarChar(240)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionId   String     @map("permission_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([organizationId, roleId, permissionId])
  @@index([organizationId, permissionId], map: "role_permissions_org_permission_idx")
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String     @map("organization_id") @db.Uuid
  membershipId   String     @map("membership_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([organizationId, membershipId, roleId])
  @@index([organizationId, roleId], map: "membership_roles_org_role_idx")
  @@map("membership_roles")
}

model Invitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(254)
  normalizedEmail  String           @map("normalized_email") @db.VarChar(254)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  roleId           String           @map("role_id") @db.Uuid
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role             Role             @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt], map: "invitations_org_status_expiry_idx")
  @@index([normalizedEmail, status], map: "invitations_email_status_idx")
  @@map("invitations")
}

model Session {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  deviceName     String         @map("device_name") @db.VarChar(120)
  userAgentHash  String         @map("user_agent_hash") @db.Char(64)
  ipAddress      String         @map("ip_address") @db.Inet
  mfaVerifiedAt  DateTime?      @map("mfa_verified_at") @db.Timestamptz(6)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason   String?        @map("revoke_reason") @db.VarChar(80)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]

  @@unique([id, organizationId], map: "sessions_id_org_key")
  @@index([organizationId, userId, revokedAt], map: "sessions_org_user_active_idx")
  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model RefreshToken {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  familyId       String        @map("family_id") @db.Uuid
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  parentTokenId  String?       @unique @map("parent_token_id") @db.Uuid
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session        Session       @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentToken    RefreshToken? @relation("RefreshTokenChain", fields: [parentTokenId], references: [id], onDelete: Restrict)
  childToken     RefreshToken? @relation("RefreshTokenChain")

  @@index([organizationId, sessionId, expiresAt], map: "refresh_tokens_org_session_expiry_idx")
  @@index([familyId, revokedAt], map: "refresh_tokens_family_revoked_idx")
  @@map("refresh_tokens")
}

model MfaChallenge {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  attempts       Int          @default(0)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, expiresAt], map: "mfa_challenges_org_user_expiry_idx")
  @@map("mfa_challenges")
}

model Asset {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  ownerMembershipId  String?           @map("owner_membership_id") @db.Uuid
  key                String            @db.VarChar(64)
  name               String            @db.VarChar(120)
  description        String            @default("") @db.VarChar(500)
  type               AssetType
  criticality        AssetCriticality
  status             AssetStatus       @default(ACTIVE)
  tags               String[]          @default([])
  version            Int               @default(1)
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner              Membership?       @relation(fields: [ownerMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceDependencies AssetDependency[] @relation("AssetDependencySource")
  targetDependencies AssetDependency[] @relation("AssetDependencyTarget")

  @@unique([organizationId, key], map: "assets_org_key_key")
  @@unique([id, organizationId], map: "assets_id_org_key")
  @@index([organizationId, status, criticality], map: "assets_org_status_criticality_idx")
  @@index([organizationId, ownerMembershipId], map: "assets_org_owner_idx")
  @@map("assets")
}

model AssetDependency {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  sourceAssetId  String              @map("source_asset_id") @db.Uuid
  targetAssetId  String              @map("target_asset_id") @db.Uuid
  kind           AssetDependencyKind
  description    String              @default("") @db.VarChar(240)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceAsset    Asset               @relation("AssetDependencySource", fields: [sourceAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  targetAsset    Asset               @relation("AssetDependencyTarget", fields: [targetAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceAssetId, targetAssetId, kind], map: "asset_dependencies_edge_key")
  @@unique([id, organizationId], map: "asset_dependencies_id_org_key")
  @@index([organizationId, targetAssetId], map: "asset_dependencies_org_target_idx")
  @@map("asset_dependencies")
}

model Connector {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  key            String          @db.VarChar(64)
  name           String          @db.VarChar(120)
  description    String          @default("") @db.VarChar(500)
  type           ConnectorType
  status         ConnectorStatus @default(ACTIVE)
  configuration  Json            @default("{}")
  version        Int             @default(1)
  lastSeenAt     DateTime?       @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  webhookSecrets WebhookSecret[]
  apiKeys        ApiKey[]

  @@unique([organizationId, key], map: "connectors_org_key_key")
  @@unique([id, organizationId], map: "connectors_id_org_key")
  @@index([organizationId, status, type], map: "connectors_org_status_type_idx")
  @@map("connectors")
}

model WebhookSecret {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  connectorId       String       @map("connector_id") @db.Uuid
  createdByUserId   String       @map("created_by_user_id") @db.Uuid
  secretHash        String       @unique @map("secret_hash") @db.Char(64)
  encryptedSecret   String       @map("encrypted_secret") @db.Text
  encryptionIv      String       @map("encryption_iv") @db.VarChar(32)
  encryptionAuthTag String       @map("encryption_auth_tag") @db.VarChar(32)
  prefix            String       @db.VarChar(12)
  validFrom         DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector         Connector    @relation(fields: [connectorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy         User         @relation("WebhookSecretCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId], map: "webhook_secrets_id_org_key")
  @@index([organizationId, connectorId, revokedAt, expiresAt], map: "webhook_secrets_active_idx")
  @@map("webhook_secrets")
}

model ApiKey {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  connectorId     String       @map("connector_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  name            String       @db.VarChar(120)
  prefix          String       @unique @db.VarChar(16)
  tokenHash       String       @unique @map("token_hash") @db.Char(64)
  scopes          String[]     @default([])
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector       Connector    @relation(fields: [connectorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy       User         @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId], map: "api_keys_id_org_key")
  @@index([organizationId, connectorId, revokedAt], map: "api_keys_connector_active_idx")
  @@map("api_keys")
}

model IdempotencyRecord {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  actorUserId     String?           @map("actor_user_id") @db.Uuid
  scope           String            @db.VarChar(120)
  keyHash         String            @map("key_hash") @db.Char(64)
  requestHash     String            @map("request_hash") @db.Char(64)
  status          IdempotencyStatus @default(PROCESSING)
  responseStatus  Int?              @map("response_status")
  responsePayload Json?             @map("response_payload")
  resourceType    String?           @map("resource_type") @db.VarChar(80)
  resourceId      String?           @map("resource_id") @db.Uuid
  expiresAt       DateTime          @map("expires_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor           User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash], map: "idempotency_records_org_scope_key")
  @@index([organizationId, expiresAt], map: "idempotency_records_expiry_idx")
  @@map("idempotency_records")
}

model EventRecord {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(120)
  targetType     String       @map("target_type") @db.VarChar(80)
  targetId       String       @map("target_id") @db.VarChar(120)
  outcome        String       @db.VarChar(32)
  correlationId  String       @map("correlation_id") @db.VarChar(80)
  ipHash         String?      @map("ip_hash") @db.Char(64)
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("EventRecordActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt], map: "event_records_org_time_idx")
  @@index([organizationId, action, occurredAt], map: "event_records_org_action_time_idx")
  @@map("event_records")
}

model OutboxEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  aggregateType  String        @map("aggregate_type") @db.VarChar(100)
  aggregateId    String        @map("aggregate_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(150)
  payload        Json
  status         OutboxStatus  @default(PENDING)
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime      @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  retryCount     Int           @default(0) @map("retry_count")
  lastErrorCode  String?       @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt], map: "outbox_events_dispatch_idx")
  @@index([organizationId, occurredAt], map: "outbox_events_tenant_time_idx")
  @@map("outbox_events")
}
