{
  "name": "aegisflow",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multi-organizacion para deteccion, respuesta y gestion segura de incidentes.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint prisma.config.ts prisma scripts --max-warnings=0 && turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "verify": "pnpm check:runtime && pnpm prisma:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm prisma:validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "smoke:phase6": "tsx scripts/smoke-phase6.ts",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yaml,yml,css}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  }
}
