{
  "name": "@aegisflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aegisflow/ai": "workspace:*",
    "@aegisflow/contracts": "workspace:*",
    "@aegisflow/domain": "workspace:*",
    "bullmq": "6.0.7",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "pg": "8.22.0",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "testcontainers": "11.9.0",
    "vitest": "4.1.10"
  }
}
